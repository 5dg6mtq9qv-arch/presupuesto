POSTGRES_DB=presupuesto
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true

# Correo saliente para recuperación de contraseña mediante Hostinger Mail.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_HOST_USER=contacto@felixiot.site
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=true
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=Félix IoT <contacto@felixiot.site>
# Opcional: clave maestra separada para cifrar la contraseña SMTP guardada en Admin.
# Si se omite, se deriva de DJANGO_SECRET_KEY, que debe permanecer estable.
EMAIL_CONFIG_ENCRYPTION_KEY=
# Los enlaces de recuperación vencen después de una hora.
PASSWORD_RESET_TIMEOUT=3600

# Asistente externo (Groq). No guardes una clave real en este archivo de ejemplo.
AI_ASSISTANT_ENABLED=true
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b
AI_BASE_URL=https://api.groq.com/openai/v1
AI_TIMEOUT_SECONDS=25
# Opcional: usa una clave maestra independiente y estable para cifrar tokens guardados desde Django Admin.
AI_CONFIG_ENCRYPTION_KEY=
